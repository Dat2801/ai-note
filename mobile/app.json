{
  "expo": {
    "name": "AI Note",
    "slug": "ai-note",
    "scheme": "ainote",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dat2801.ainote",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "AI Note cần kết nối máy chủ AI trong mạng nội bộ khi phát triển."
      }
    },
    "android": {
      "package": "vn.ainote.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "AI Note cần dùng micro để ghi âm cuộc họp, bài giảng và chuyển thành ghi chú."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "febcc037-f752-48f9-aa13-403db488f8ac"
      }
    },
    "owner": "datvhs-team"
  }
}
