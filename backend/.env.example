# Để trống OPENAI_API_KEY (hoặc MOCK_AI=true) để chạy chế độ giả lập, không tốn phí
OPENAI_API_KEY=
MOCK_AI=false

OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-6-luna
TRANSCRIPTION_LANGUAGE=vi

# Token chung giữa app và backend. Để trống = không kiểm tra (chỉ dùng trong mạng nội bộ)
APP_TOKEN=

PORT=4000
HOST=0.0.0.0
